---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title='Contact Us' description='Contact Analytixware Technologies for a free demo of our data analytics and dashboard services.' active='contact.html'>
    <PageHero title="Contact Us" />

        <div class="container-fluid py-5">
        <div class="container py-5">
            <div class="mx-auto text-center" style="max-width: 500px;">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Contact Us</div>
                <h1 class="mb-4">Please contact us for a free demo</h1>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-7">
                  
                    <div class = "row justify-content-center">

<iframe src="https://docs.google.com/forms/d/e/1FAIpQLSfQdeYQU3rfuYcSjdjCiDK0R8qmTB05lOQ-d-FD6TKX89gMHQ/viewform?embedded=true" width="640" height="887" frameborder="0" marginheight="0" marginwidth="0">Loading...</iframe>
                 
                    </div>
                </div>
            </div>
        </div>
    </div>
</Base>
