---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title='About Us' description='About Analytixware Technologies, an Ahmedabad-based data analytics, dashboard and machine learning company.' active='/about'>
    <PageHero title="About Us" />

        <div class="container-fluid py-5">
        <div class="container py-5">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                    <div class="about-img">
                        <img loading="lazy" decoding="async" class="img-fluid" src="/img/about-img.jpg">
                    </div>
                </div>
                <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                    <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">About Us</div>
                    <h1 class="mb-4">We Make Your Business Smarter with Analytixware</h1>
                    <p class="mb-4">Analytixware - a small business company, started in October 2020. We aim to bring all our knowledge and expertise together and provide business intelligence solutions to our clients.</p>
                    <p class="mb-4"> Let us empower your organization with the intelligence needed to thrive in a data-driven world.</p>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <h6 class="mb-3"><i class="fa fa-check text-primary me-2"></i> Cutting-Edge Technology</h6>
                            <h6 class="mb-0"><i class="fa fa-check text-primary me-2"></i> Data-Driven Solutions</h6>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="mb-3"><i class="fa fa-check text-primary me-2"></i>24/7 Support</h6>
                            <h6 class="mb-0"><i class="fa fa-check text-primary me-2"></i>Fair Prices</h6>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mt-4">

<a class="btn btn-outline-primary btn-square me-3" href="mailto:bhavik@analytixware.in"><i
                                                    class="fas fa-envelope"></i></a>

                        <a class="btn btn-outline-primary btn-square me-3" target="_blank"  href="https://x.com/AnalytixwareIn"><i class="fab fa-twitter"></i></a>
<a class="btn btn-outline-primary btn-square me-3" target="_blank" href="https://instagram.com/Analytixware"><i class="fab fa-instagram"></i></a>
                       
                        <a class="btn btn-outline-primary btn-square" target="_blank" href="https://www.linkedin.com/company/analytixware-technologies-pvt-ltd/"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid bg-primary feature pt-5">
        <div class="container pt-5">
            <div class="row g-5">
                <div class="col-lg-6 align-self-center mb-md-5 pb-md-5 wow fadeIn" data-wow-delay="0.3s">
                    <div class="btn btn-sm border rounded-pill text-white px-3 mb-3">Why Choose Us</div>
                    <h1 class="text-white mb-4">"Empowering Your Business with Expertise, Innovation, and Tailored Solutions."
                    </h1>
                    <p class="text-light mb-4">Choose us for our proven expertise, innovative solutions, customized approach, and commitment to delivering high-quality results tailored to your business needs.
                    </p>
                                        <div class="d-flex align-items-center text-white mb-3">
                        <div class="btn-sm-square bg-white text-primary rounded-circle me-3">
                            <i class="fa fa-check"></i>
                        </div>
                        <span>Scalability</span>
                    </div>
                    <div class="d-flex align-items-center text-white mb-3">
                        <div class="btn-sm-square bg-white text-primary rounded-circle me-3">
                            <i class="fa fa-check"></i>
                        </div>
                        <span>Affordability</span>
                    </div>
                    <div class="d-flex align-items-center text-white mb-3">
                        <div class="btn-sm-square bg-white text-primary rounded-circle me-3">
                            <i class="fa fa-check"></i>
                        </div>
                        <span>Flexibility</span>
                    </div>
                    <div class="d-flex align-items-center text-white mb-3">
                        <div class="btn-sm-square bg-white text-primary rounded-circle me-3">
                            <i class="fa fa-check"></i>
                        </div>
                        <span>One Stop Solution</span>
                    </div>
                    <div class="row g-4 pt-3">
                        <div class="col-sm-6">
                            <div class="d-flex rounded p-3" style="background: rgba(256, 256, 256, 0.1);">
                                <i class="fa fa-users fa-3x text-white"></i>
                                <div class="ms-3">
                                    <h2 class="text-white mb-0" data-toggle="counter-up">15</h2>
                                    <p class="text-white mb-0">Happy Clients</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex rounded p-3" style="background: rgba(256, 256, 256, 0.1);">
                                <i class="fa fa-check fa-3x text-white"></i>
                                <div class="ms-3">
                                    <h2 class="text-white mb-0" data-toggle="counter-up">40</h2>
                                    <p class="text-white mb-0"> Projects Completed</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 align-left text-center text-md-end wow fadeIn" data-wow-delay="0.05s">
                    <img loading="lazy" decoding="async" class="img-fluid" src="/img/feature.png" alt="">
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid bg-light py-5">
        <div class="container py-5">
            <div class="row g-6 align-items-center">
                <div class="col-lg-5 wow fadeIn" data-wow-delay="0.1s">
                    <h1 class="mb-4">Meet Our CEO</h1>
                    <img loading="lazy" decoding="async" class="img-fluid square" src="/img/team-1.jpg" alt="">
                                        <h5 class="mb-0">Bhavik Mehta</h5>
                                        <small>Founder & CEO</small>

                </div>

                                <div class="col-lg-5 wow fadeIn" data-wow-delay="0.1s">
                                    
                                        <p>
                                            A highly skilled data scientist with over 9 years of experience in machine learning, data science, and cloud technologies and over 16 years of experience in IT. Bhavik has a strong background in Python, R, SQL, GCP services, and Agile methodologies, with a focus on delivering impactful, data-driven solutions. His expertise spans across building scalable models, advanced analytics, and customized solutions that align with business objectives, driving growth and efficiency.

                                            </p>
                                        
                                    </div>
                                    
                        </div>
                    </div>            
                </div>
</Base>
