---
import Base from '../layouts/Base.astro';
---
<Base title='Analytixware Technologies - Data Analysis & Executive Dashboards' description='Analytixware Technologies delivers top-tier data analytics and visualization solutions, offering customized executive dashboards for business insights.' keywords='Data Analysis, Data Visualization, AI Solutions, Executive Dashboards, Analytixware, Machine Learning, ETL Services' active='index.html' spinner={false} og={{"title":"Unlock the Power of Your Retail Data with Analytixware","description":"Discover how custom dashboards and data analytics can drive your retail business forward. Sign up for a 60-day free trial!","image":"https://analytixware.in/img/back.jpg","url":"https://analytixware.in"}}>
    <section class="hero-section" role="banner">
        <div class="container-fluid pt-5 bg-primary hero-header mb-5">
            <div class="container pt-5">
                <div class="row g-5 pt-5">
                    <div class="col-lg-6 align-self-center text-center text-lg-start mb-lg-5">
                        <h1 class="display-4 text-white mb-4 animated slideInRight">Data Analysis for Your Business</h1>
                        <p class="text-white mb-4 animated slideInRight">Organizations that leverage data analytics effectively gain a competitive edge in today's data-driven world. By analyzing data, businesses can identify unique insights and trends to stay ahead of the competition.</p>
                        <a href="about.html" class="btn btn-light py-sm-3 px-sm-5 rounded-pill me-3 animated slideInRight">Read More</a>
                        <a href="contact.html" class="btn btn-outline-light py-sm-3 px-sm-5 rounded-pill animated slideInRight">Contact Us</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <main>
        
        <section class="dashboard-projects py-5">
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                        <div class="video-loop">
                            <video class="img-fluid" autoplay muted loop aria-label="Executive Dashboard Video">
                                <source src="img/bankmetrics.mp4" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                        </div>
                    </div>
                    <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                        <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Executive Dashboard Service</div>
                        <h2 class="mb-4">Power Your Business with Looker Studio Dashboards</h2>
                        <p>Our executive dashboards offer real-time insights with Looker Studio, empowering decision-makers at every level. Explore our data visualization templates  ->  <a href="dashboards.html" class="highlight-link">here</a></p>
                        <p>View critical business metrics, monitor performance, and make data-driven decisions. <a href="contact.html">Contact us</a> for a free demo.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="services bg-light py-5">
            <div class="container py-5">
                <header class="text-center">
                    <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Our Services</div>
                    <h2 class="mb-4">Comprehensive Data Analysis Solutions</h2>
                </header>
                <div class="row g-4">
                    
                    <div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="0.3s">
                        <div class="service-item d-flex flex-column justify-content-center text-center rounded">
                            <div class="service-icon btn-square">
                                <i class="fa fa-chart-bar fa-2x"></i>
                            </div>
                            <h5 class="mb-3">Statistical Analysis</h5>
                            <p>Turn raw business data into reliable patterns, segments, forecasts, and decision-ready evidence.</p>
                            <a class="btn px-3 mt-auto mx-auto" href="service.html">Read More</a>
                        </div>
                    </div>
			<div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="0.5s">
                            <div class="service-item d-flex flex-column justify-content-center text-center rounded">
                                <div class="service-icon btn-square">
                                    <i class="fa fa-brain fa-2x icon"></i>
                                </div>
                                <h5 class="mb-3">Machine Learning</h5>
                                <p>Build predictive models that improve targeting, risk scoring, retention, forecasting, and automation.</p>
                                <a class="btn px-3 mt-auto mx-auto" href="service.html">Read More</a>
                            </div>
                        </div>
			<div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="0.7s">
                            <div class="service-item d-flex flex-column justify-content-center text-center rounded">
                                <div class="service-icon btn-square">
                                    <i class="fa fa-chart-pie fa-2x icon    "></i>
                                </div>
                                <h5 class="mb-3">Data Visualization</h5>
                                <p>Design dashboards that make KPIs, trends, and operational decisions clear at a glance.</p>
                                <a class="btn px-3 mt-auto mx-auto" href="service.html">Read More</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="1.3s">
                            <div class="service-item d-flex flex-column justify-content-center text-center rounded">
                                <div class="service-icon btn-square">
                                    <i class="fa fa-dollar-sign fa-2x icon"></i>
                                </div>
                                <h5 class="mb-3">Financial Models</h5>
                                <p>Model growth, profitability, risk, budgets, and scenarios with practical analytics workflows.</p>
                                <a class="btn px-3 mt-auto mx-auto" href="service.html">Read More</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="1.5s">
                            <div class="service-item d-flex flex-column justify-content-center text-center rounded">
                                <div class="service-icon btn-square">
                                    <i class="fa fa-chart-line fa-2x icon"></i>
                                </div>
                                <h5 class="mb-3">Data Integration and ETL</h5>
                                <p>Connect spreadsheets, apps, databases, and cloud tools into clean analytics-ready datasets.</p>
                                <a class="btn px-3 mt-auto mx-auto" href="service.html">Read More</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="1.9s">
                            <div class="service-item d-flex flex-column justify-content-center text-center rounded">
                                <div class="service-icon btn-square">
                                    <i class="fa fa-code icon"></i>
                                </div>
                                <h5 class="mb-3">Process Automation</h5>
                                <p>Reduce repetitive reporting and manual operations with lightweight automation built around your workflow.</p>
                                <a class="btn px-3 mt-auto mx-auto" href="service.html">Read More</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="2.1s">
                            <div class="service-item d-flex flex-column justify-content-center text-center rounded">
                                <div class="service-icon btn-square">
                                    <i class="fa fa-code icon"></i>
                                </div>
                                <h5 class="mb-3">Process Optimization</h5>
                                <p>Use data to identify bottlenecks, improve throughput, and focus teams on high-impact actions.</p>
                                <a class="btn px-3 mt-auto mx-auto" href="service.html">Read More</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="2.7s">
                            <div class="service-item d-flex flex-column justify-content-center text-center rounded">
                                <div class="service-icon btn-square">
                                    <i class="fa fa-comments fa-2x icon"></i>
                                </div>
                                <h5 class="mb-3">Natural Language Processing</h5>
                                <p>Analyze customer feedback, documents, and conversations with text analytics and language models.</p>
                                <a class="btn px-3 mt-auto mx-auto" href="service.html">Read More</a>
                            </div>
                        </div>
                </div>
            </div>
        </section>
    </main>
</Base>
