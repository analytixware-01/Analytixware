---
import Base from '../layouts/Base.astro';
---
<Base title='Analytixware - Data Analysis'>
    <div class="container-fluid pt-5 bg-primary hero-header mb-5">
        <div class="container pt-5">
            <div class="row g-5 pt-5">
                <div class="col-lg-6 align-self-center text-center text-lg-start mb-lg-5">
                    
                    <h1 class="display-4 text-white mb-4 animated slideInRight">Data Analysis for Your Business</h1>
                    <p class="text-white mb-4 animated slideInRight">Organizations that leverage data analytics effectively gain a competitive edge in today's data-driven world. By analyzing data, businesses can identify unique insights and trends that better understand the market and their competitors, helping them stay ahead of the competition.</p>
                    <a href="about.html" class="btn btn-light py-sm-3 px-sm-5 rounded-pill me-3 animated slideInRight">Read More</a>
                    <a href="contact.html" class="btn btn-outline-light py-sm-3 px-sm-5 rounded-pill animated slideInRight">Contact Us</a>
                </div>
                
            </div>
        </div>
    </div>

    <div class="modal fade" id="searchModal" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content" style="background: rgba(20, 24, 62, 0.7);">
                <div class="modal-header border-0">
                    <button type="button" class="btn btn-square bg-white btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body d-flex align-items-center justify-content-center">
                    <div class="input-group" style="max-width: 600px;">
                        <input type="text" class="form-control bg-transparent border-light p-3"
                            placeholder="Type search keyword">
                        <button class="btn btn-light px-4"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

<div class="container-fluid py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="video-loop">

 		<video class="img-fluid" autoplay muted loop>
                        <source src="img/bankmetrics.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>

            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Executive Dashboard Service</div>
                <h1 class="mb-4">Power Your Business with Looker Studio Dashboards</h1>
                <p class="mb-4">Our executive dashboards give you the power of data visualization and insights in real-time. Using Looker Studio, we create customized dashboards that empower decision-makers at every level.</p>
                <p class="mb-4">Discover key business metrics at a glance, monitor performance, and make informed decisions with ease. <a href="contact.html"> Contact Us </a> for a free demo.</p>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <h6 class="mb-3"><i class="fa fa-check text-primary me-2"></i>Real-Time Data</h6>
                        <h6 class="mb-0"><i class="fa fa-check text-primary me-2"></i>Customizable Reports</h6>
                    </div>
                    <div class="col-sm-6">
                        <h6 class="mb-3"><i class="fa fa-check text-primary me-2"></i>Interactive Dashboards</h6>
                        <h6 class="mb-0"><i class="fa fa-check text-primary me-2"></i>Advanced Analytics</h6>
                    </div>
                </div>
                <div class="d-flex align-items-center mt-4">
                    <a class="btn btn-outline-primary btn-square me-3" href="mailto:bhavik@analytixware.in"><i class="fas fa-envelope"></i></a>
                    <a class="btn btn-outline-primary btn-square me-3" target="_blank" href="https://x.com/AnalytixwareIn"><i class="fab fa-twitter"></i></a>
                    <a class="btn btn-outline-primary btn-square" target="_blank" href="https://www.linkedin.com/company/analytixware-technologies-pvt-ltd/"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

    <div class="container-fluid bg-light py-5">
