---
import { getInFileOrder } from '../lib/content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DashboardRow from '../components/DashboardRow.astro';

// Thank-you page after form submission: shows the dashboard templates (same data as dashboards.html).
const dashboards = await getInFileOrder('dashboards');
---
<Base title="Dashboard Templates" description="Thank you for contacting Analytixware.">
    <PageHero title="Dashboard Templates" />

    <div class="container">
        {dashboards.map((d, i) => <DashboardRow dashboard={d.data} reverse={i % 2 === 1} />)}
    </div>
</Base>
