---
import { getInFileOrder } from '../lib/content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DashboardRow from '../components/DashboardRow.astro';

// Templates live in src/content/dashboards.yaml, shown in file order.
const dashboards = await getInFileOrder('dashboards');
---
<Base title="Dashboard Templates" description="Looker Studio executive dashboard templates for banking, retail, e-commerce, marketing and supply chain.">
    <PageHero title="Dashboard Templates" />

    <div class="container">
        {dashboards.map((d, i) => <DashboardRow dashboard={d.data} reverse={i % 2 === 1} />)}
    </div>
</Base>
