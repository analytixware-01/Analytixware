---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BlogCard from '../components/BlogCard.astro';

// Posts live in src/content/blog/*.md — newest first, drafts hidden.
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog" description="Articles from Analytixware on business intelligence, data analytics, dashboards and machine learning." active="/blog">
    <PageHero title="Blogs" />

    <div class="container my-5">
        {posts.map((post) => <BlogCard post={post} />)}
    </div>
</Base>
