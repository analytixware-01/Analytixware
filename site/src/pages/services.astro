---
import { getInFileOrder } from '../lib/content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';

// Services live in src/content/services.yaml (the same list feeds the home page).
const services = await getInFileOrder('services');
---
<Base title="Services" description="Analytixware services: AI-driven solutions, cloud data integration and warehousing, statistical analysis, machine learning, data visualization, financial models, automation and NLP." active="/services">
    <PageHero title="Our Services" />

    <div class="container-fluid bg-light py-5">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-5 wow fadeIn text-center">
                    <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Our Services</div>
                    <h2 class="no-wrap">Our AI, Cloud &amp; Data Analytics Solutions</h2>
                </div>
                <div class="row g-5 align-items-center">
                    <div class="col-12">
                        <div class="row g-4 justify-content-center">
                            {services.map((s) => <ServiceCard service={s.data} variant="full" />)}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Base>

<style is:inline>
    h2.no-wrap {
        white-space: nowrap;
        font-size: 1.8rem;
    }
</style>
