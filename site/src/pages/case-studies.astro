---
import { getInFileOrder } from '../lib/content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';

// Case studies live in src/content/case-studies.yaml.
const studies = await getInFileOrder('caseStudies');
---
<Base title="Case Studies" description="Analytixware case studies in donor optimal ask, credit risk modeling and propensity to pay." active="/case-studies">
    <PageHero title="Our Projects" />

    <div class="container-fluid bg-light py-5">
        <div class="container py-5">
            <div class="mx-auto text-center wow fadeIn" style="max-width: 500px;">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Case Study</div>
                <h2 class="no-wrap">Explore Our Recent  Case Studies</h2>
            </div>
            <div class="row g-10 justify-content-center">
                {studies.map((s) => <CaseStudyCard study={s.data} />)}
            </div>
        </div>
    </div>
</Base>

<style is:inline>
    h2.no-wrap {
        white-space: nowrap;
        font-size: 1.8rem;
    }
</style>
