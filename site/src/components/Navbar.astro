---
import { site } from '../data/site';
interface Props { active?: string }
const { active } = Astro.props;
---
<div class="container-fluid sticky-top">
    <div class="container">
        <nav class="navbar navbar-expand-lg navbar-dark p-0" aria-label="Primary Navigation">
            <a href="/" class="navbar-brand">
                <h1 class="text-white"><img src="/img/logo-no-background.png" class="logo" alt="Analytixware Logo"><span class="visually-hidden">Analytixware</span></h1>
            </a>
            <button type="button" class="navbar-toggler ms-auto me-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto">
                    {site.nav.map((item) => (
                        <a href={item.href} class:list={['nav-item nav-link', { active: item.href === active }]} aria-current={item.href === active ? 'page' : undefined}>{item.label}</a>
                    ))}
                </div>
            </div>
        </nav>
    </div>
</div>
