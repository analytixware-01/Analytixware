---
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>['data'];
  /** "summary": short text + Read More (home page). "full": long description (Services page). */
  variant?: 'summary' | 'full';
}
const { service, variant = 'summary' } = Astro.props;
---
<div class="col-lg-4 col-md-6 wow fadeIn">
    <div class="service-item d-flex flex-column justify-content-start text-center rounded">
        <div class="service-icon btn-square">
            <i class={`fa ${service.icon} fa-2x icon`}></i>
        </div>
        <h5 class="mb-3">{service.title}</h5>
        <p>{variant === 'summary' ? service.summary : service.description}</p>
        {variant === 'summary' && <a class="btn px-3 mt-auto mx-auto" href="/services">Read More</a>}
    </div>
</div>
